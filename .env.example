# Local defaults matching docker-compose.yml. Copy to .env and fill in keys.
PG_DSN=postgresql://brain:brain@localhost:5432/brain
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=brainbrain
QDRANT_URL=http://localhost:6333
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=brain
MINIO_SECRET_KEY=brainbrain
TEMPORAL_ADDRESS=localhost:7233

# Extraction (required for ingestion / calibration)
ANTHROPIC_API_KEY=

# Embeddings: "mock" works offline; "voyage" needs VOYAGE_API_KEY
EMBEDDER_PROVIDER=mock
# Must match the Qdrant collection size; voyage-4 and MockEmbedder both default to 1024.
EMBEDDING_DIM=1024
VOYAGE_API_KEY=

OWNER_DISPLAY_NAME=Abhishek
OWNER_TIMEZONE=Asia/Kolkata
